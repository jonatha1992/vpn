{
  "manifest_version": 3,
  "name": "Pasaporte VPN",
  "author": "tecnofusion.it",
  "version": "1.3.2",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "description": "Elegí tu país de salida y verificá tu IP pública. Conexión por proxy para el tráfico web de Chrome.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Pasaporte VPN", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}}
}
